rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /streaks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Device accounts tracking (server-side only)
    match /device_accounts/{document} {
      allow read, write: if false;
    }
    
    // Temporary collections for device checks
    match /device_checks/{document} {
      allow create: if true;  // Allow creation for unauthenticated users
      allow read, update, delete: if isAuthenticated() && 
        (resource.data.deviceId == request.resource.data.deviceId);
    }
    
    match /device_records/{document} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid);
    }
    
    // User profiles
    match /users/{userId} {
      allow read: if true;  // Allow reading for device checks
      allow create: if true;  // Allow creating new users
      allow update: if isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userStatus']) || 
         request.resource.data.userStatus in ['free', 'premium']);
      allow delete: if isOwner(userId);
    }
    
    // Journal entries rules
    match /journal_entries/{entryId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Reframes rules
    match /reframes/{reframeId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Nonsense tracking rules
    match /nonsense_tracking/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Coach messages
    match /coachMessages/{messageId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Coach history
    match /coachHistory/{historyId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Coach assignments
    match /coachAssignments/{userId} {
      allow read: if isAuthenticated() && userId == request.auth.uid;
      allow write: if isAuthenticated() && userId == request.auth.uid;
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 